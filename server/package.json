{
  "name": "restaurant-pos-server",
  "version": "1.0.0",
  "description": "Restaurant management backend (PostgreSQL, Express, Node.js)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test src/config/envValidation.test.js src/middleware/security.test.js src/services/permissionService.test.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node src/scripts/seed.js",
    "db:use": "node src/scripts/setDatabaseUrl.js",
    "db:migrate": "node src/database/migrationRunner.js up",
    "db:rollback": "node src/database/migrationRunner.js down",
    "db:status": "node src/database/migrationRunner.js status",
    "db:seed": "node src/database/seedRunner.js",
    "db:migrate:documents": "node src/database/migrateDocuments.js",
    "production:db:sync": "node src/scripts/productionDbSync.js",
    "users:backfill-vendor-scopes": "node src/scripts/backfillVendorUserScopes.js",
    "data:backfill-demo-tenant": "node src/scripts/backfillDemoTenantScope.js",
    "print:selftest": "node src/scripts/printService.selftest.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
