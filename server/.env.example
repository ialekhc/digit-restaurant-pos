PORT=5500
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_pos
CORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_pos
DATABASE_SSL=false
USE_LEGACY_DOCUMENT_STORAGE=false
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5400

# QZ Tray trusted signing. Prefer base64 values in hosted environments.
# Generate these through QZ Tray Site Manager (development) or QZ's certificate portal (production).
QZ_DIGITAL_CERTIFICATE_BASE64=
QZ_PRIVATE_KEY_BASE64=
